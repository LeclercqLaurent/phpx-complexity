{
    "name": "codeam/phpx-complexity",
    "description": "A multi-lens, offline PHP complexity auditor: it reimplements the SonarQube family (S3776/S1142/S107) natively, adds an entanglement lens, and plays the lenses against each other in a divergence report.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "static-analysis",
        "complexity",
        "cognitive-complexity",
        "code-quality",
        "audit"
    ],
    "authors": [
        {
            "name": "Codeam",
            "email": "laurent@codeam.fr"
        }
    ],
    "require": {
        "php": ">=8.2",
        "nikic/php-parser": "^5.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "~3.95.0",
        "phpstan/phpstan": "~2.2.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "PhpxComplexity\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpxComplexity\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/phpx-complexity"
    ],
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "qa": "scripts/qa.sh"
    },
    "config": {
        "sort-packages": true
    }
}
