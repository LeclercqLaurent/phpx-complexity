#!/usr/bin/env bash
# A fake "git" for the tests: it reproduces a clone with no network and records
# the arguments received, so the hardening of the command stays verifiable.
set -u

target="${@: -1}"
url="${@: -2:1}"
root="$(dirname "$target")"

printf '%s\n' "$@" > "$root/args.txt"

if [ "$url" = "https://example.org/echec.git" ]; then
    echo "fatal: repository 'https://example.org/echec.git' not found" >&2
    exit 128
fi

mkdir -p "$target/src"
cat > "$target/src/Cloned.php" <<'PHPEOF'
<?php

declare(strict_types=1);

final class Cloned
{
    public function run(int $a): int
    {
        return $a;
    }
}
PHPEOF
exit 0
