#!/usr/bin/env php
<?php

declare(strict_types=1);

use PhpxComplexity\Cli\Application;

(static function (): void {
    $candidates = [
        __DIR__ . '/../vendor/autoload.php', // cloned repository / dev
        __DIR__ . '/../../../autoload.php',  // installed as a dependency
    ];
    foreach ($candidates as $autoload) {
        if (is_file($autoload)) {
            require $autoload;

            return;
        }
    }
    fwrite(\STDERR, "Composer autoloader not found. Run 'composer install'.\n");
    exit(2);
})();

exit((new Application())->run($argv));
